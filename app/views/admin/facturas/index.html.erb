<% content_for :title, "Facturas" %>

<div class="encabezado">
  <h1>Facturas</h1>
  <%= link_to "Nueva factura", new_admin_factura_path, class: "boton" %>
</div>

<% if @facturas.any? %>
  <table>
    <thead>
      <tr>
        <th>Proveedor</th>
        <th>Número</th>
        <th>Emisión</th>
        <th>Vencimiento</th>
        <th class="num">Total</th>
        <th class="num">Saldo</th>
        <th>Estado</th>
      </tr>
    </thead>
    <tbody>
      <% @facturas.each do |factura| %>
        <tr>
          <td><%= link_to factura.proveedor.nombre, admin_proveedor_path(factura.proveedor) %></td>
          <td><%= link_to factura.numero, admin_factura_path(factura) %></td>
          <td><%= l factura.fecha_emision %></td>
          <td><%= l factura.fecha_vencimiento %></td>
          <td class="num"><%= number_to_currency(factura.total) %></td>
          <td class="num"><%= number_to_currency(factura.saldo) %></td>
          <td><span class="estado estado--<%= factura.estado %>"><%= t("estados.#{factura.estado}") %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="vacio">Todavía no hay facturas cargadas.</p>
<% end %>
