<% content_for :title, "Registrar pago" %>

<div class="encabezado">
  <h1>Registrar pago</h1>
  <%= link_to "Volver", admin_factura_path(@factura) %>
</div>

<p class="vacio">
  Factura <%= @factura.numero %> de <%= @factura.proveedor.nombre %> ·
  saldo pendiente <strong><%= number_to_currency(@factura.saldo) %></strong>
</p>

<%= render "form", pago: @pago, medios_de_pago: @medios_de_pago %>
