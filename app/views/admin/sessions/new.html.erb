<% content_for :title, "Iniciar sesión" %>

<h1>Back-office</h1>
<p class="vacio">Ingresá con tu usuario administrador.</p>

<%= form_with url: admin_session_path, class: "tarjeta" do |f| %>
  <div class="campo">
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, value: params[:email], autofocus: true, required: true %>
  </div>
  <div class="campo">
    <%= f.label :password, "Contraseña" %>
    <%= f.password_field :password, required: true %>
  </div>
  <%= f.submit "Ingresar" %>
<% end %>
